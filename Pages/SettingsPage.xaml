<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Yoink_Downloader.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:Yoink_Downloader.Helpers"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel Spacing="16" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Tools -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Tools" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="Leave a path blank to use whatever is on PATH." />

                    <StackPanel>
                        <TextBlock Text="yt-dlp" Style="{StaticResource FieldLabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="YtDlpPathBox" PlaceholderText="yt-dlp.exe" />
                            <Button Grid.Column="1" Content="Browse..." Click="OnBrowseYtDlpClick" />
                            <Button x:Name="InstallYtDlpButton" Grid.Column="2"
                                    Content="Install" Click="OnInstallYtDlpClick" />
                        </Grid>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="ffmpeg" Style="{StaticResource FieldLabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FfmpegPathBox" PlaceholderText="ffmpeg.exe" />
                            <Button Grid.Column="1" Content="Browse..." Click="OnBrowseFfmpegClick" />
                            <Button x:Name="InstallFfmpegButton" Grid.Column="2"
                                    Content="Install" Click="OnInstallFfmpegClick" />
                        </Grid>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="aria2" Style="{StaticResource FieldLabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Aria2PathBox" PlaceholderText="aria2c.exe" />
                            <Button Grid.Column="1" Content="Browse..." Click="OnBrowseAria2Click" />
                            <Button x:Name="InstallAria2Button" Grid.Column="2"
                                    Content="Install" Click="OnInstallAria2Click" />
                        </Grid>
                    </StackPanel>

                    <ProgressBar x:Name="InstallProgress" IsIndeterminate="True" Visibility="Collapsed" />

                    <TextBlock x:Name="InstallStatusText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <InfoBar x:Name="ToolsInfoBar" IsOpen="False" IsClosable="True" Severity="Informational" />
                </StackPanel>
            </Border>

            <!-- Defaults -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Defaults" Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel>
                        <TextBlock Text="Download folder" Style="{StaticResource FieldLabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DefaultFolderBox" />
                            <Button Grid.Column="1" Content="Browse..." Click="OnBrowseFolderClick" />
                        </Grid>
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Container" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="DefaultContainerBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="MP4" Tag="mp4" />
                                <ComboBoxItem Content="MKV" Tag="mkv" />
                                <ComboBoxItem Content="WebM" Tag="webm" />
                                <ComboBoxItem Content="MP3" Tag="mp3" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Parallel downloads" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="ConcurrencyBox"
                                       Value="2"
                                       Minimum="1"
                                       Maximum="8"
                                       SpinButtonPlacementMode="Compact"
                                       HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <ToggleSwitch x:Name="OpenFolderToggle"
                                  Header="Open the folder when a download finishes"
                                  OnContent="On" OffContent="Off" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <ComboBox x:Name="PaneDisplayModeCombo"
                              helpers:CursorHelper.ForceArrowCursor="True"
                              Header="Navigation pane style"
                              SelectionChanged="PaneDisplayModeCombo_SelectionChanged">
                        <ComboBoxItem Content="Left (expanded)" Tag="Left" />
                        <ComboBoxItem Content="Left compact" Tag="LeftCompact" />
                        <ComboBoxItem Content="Left minimal" Tag="LeftMinimal" />
                        <ComboBoxItem Content="Top" Tag="Top" />
                    </ComboBox>

                    <ComboBox x:Name="ThemeCombo" Header="App theme" helpers:CursorHelper.ForceArrowCursor="True" >
                        <!-- SelectionChanged="ThemeCombo_SelectionChanged" -->
                        <ComboBoxItem Content="System default" Tag="Default" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>

                    <!-- <Button Content="Choose accent color"> -->
                    <!--     <Button.Flyout> -->
                    <!--         <Flyout> -->
                    <!--             <ColorPicker x:Name="AccentColorPicker" -->
                    <!--                          ColorSpectrumShape="Ring" -->
                    <!--                          IsMoreButtonVisible="True" /> -->
                    <!--         </Flyout> -->
                    <!--     </Button.Flyout> -->
                    <!-- </Button> -->

                <!--     <Button> -->
                <!--         <StackPanel Orientation="Horizontal" Spacing="8"> -->
                <!--             <Border Width="16" Height="16" CornerRadius="4" -->
                <!-- Background="{ThemeResource SystemAccentColorBrush}" /> -->
                <!--             <TextBlock Text="Choose accent color" /> -->
                <!--         </StackPanel> -->
                <!--         <Button.Flyout> -->
                <!--             <Flyout> -->
                <!--                 <ColorPicker x:Name="AccentColorPicker" -->
                <!--          ColorSpectrumShape="Ring" -->
                <!--          IsMoreButtonVisible="True"/> -->
                <!--                 ~1~ ColorChanged="AccentColorPicker_ColorChanged" @1@ -->
                <!--             </Flyout> -->
                <!--         </Button.Flyout> -->
                <!--     </Button> -->
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="Yoink Downloader version TODO EMBED VERSION + INFO" Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Text="This app is a general-purpose media downloader powered by yt-dlp and other tools listed. It is not affiliated with YouTube or any other platform it supports. Users are solely responsible for ensuring they have the right to download any content, and must comply with the terms of service and copyright laws applicable to them. The developer does not host, store, or distribute any downloaded content and accepts no liability for misuse"
                               Foreground="OrangeRed" TextWrapping="WrapWholeWords" />
                    <StackPanel Orientation="Horizontal">

                        <HyperlinkButton NavigateUri="https://github.com/adamduda1/yoink">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE943;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16"/>
                                <TextBlock Text="See GitHub Repo"/>
                            </StackPanel>
                        </HyperlinkButton>

                        <HyperlinkButton NavigateUri="https://github.com/adamduda1/yoink">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE774;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16"/>
                                <TextBlock Text="See GitHub Repo"/>
                            </StackPanel>
                        </HyperlinkButton>

                        <HyperlinkButton NavigateUri="https://github.com/adamduda1/yoink">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEBD3;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16"/>
                                <TextBlock Text="Get updates on Microsoft Store"/>
                            </StackPanel>
                        </HyperlinkButton>

                        <HyperlinkButton NavigateUri="https://github.com/adamduda1/yoink">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xf000;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16"/>
                                <TextBlock Text="License"/>
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
